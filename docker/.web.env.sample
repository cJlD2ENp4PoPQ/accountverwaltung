# Accountverwaltung – Web-Konfiguration
# Wird vom web-Container geladen (docker-compose.yaml: env_file).
# Alle Werte optional: leer = Default aus html/inc/env.inc.php greift.
# Lokale (nicht versionierte) Kopie: .web.env

#Admin-E-Mail-Adresse
ENV_ADMIN_EMAIL=

#Module an/aus
#internes Supportsystem aktivieren?
ENV_ENABLE_SUPPORT_PAGE=1
#DE-KB-DB aktivieren?
ENV_ENABLE_DE_KB_DB=1
#Forenmenüpunkt aktivieren?
ENV_ENABLE_FORUM_CONNECT=0

#URL-Liste
ENV_URL_PORTAL=
ENV_URL_IMPRESSUM=
ENV_URL_DATENSCHUTZ=
ENV_URL_AGB=

#Accountverwaltung (Login-System-DB)
#docker-Hostname laut extra_hosts: database
ENV_DB_LOGINSYSTEM_HOST=
ENV_DB_LOGINSYSTEM_USER=
ENV_DB_LOGINSYSTEM_PASSWORD=
ENV_DB_LOGINSYSTEM_DATABASE=

#Logging-DB
#docker-Hostname laut extra_hosts: database-logging
ENV_DB_LOGGING_HOST=
ENV_DB_LOGGING_USER=
ENV_DB_LOGGING_PASSWORD=
ENV_DB_LOGGING_DATABASE=

#SMTP-Postfach
ENV_MAIL_SERVER=
ENV_MAIL_NOREPLY=
ENV_MAIL_USER=
ENV_MAIL_PASSWORD=

#RPC Authcode
ENV_RPC_AUTHCODE=

#Datenbankverbindung für den Spielserver, erreichbar per databaseKey
#docker-Hostname laut extra_hosts: xde-database
ENV_DATABASEKEY_XDE_HOST=
ENV_DATABASEKEY_XDE_DATABASE=
ENV_DATABASEKEY_XDE_USER=
ENV_DATABASEKEY_XDE_PASSWORD=

#docker-Hostname laut extra_hosts: sde-database
ENV_DATABASEKEY_SDE_HOST=
ENV_DATABASEKEY_SDE_DATABASE=
ENV_DATABASEKEY_SDE_USER=
ENV_DATABASEKEY_SDE_PASSWORD=

#SV-Konfiguration (html/inc/sv.inc.php); leer = Default
#Defaults: debugmode=1, pcs_id=99, servid=99, server_tag=AID
ENV_SV_DEBUGMODE=
ENV_SV_PCS_ID=
ENV_SV_SERVID=
ENV_SV_SERVER_TAG=

#Gamenamen (html/inc/serverdata.inc.php); leer = Default
#Defaults: 0=DIE EWIGEN, 1=STOLEN EMPIRES, 2=ANDALUR, 3=ABLYON DEvolution
ENV_GAMENAME_0=
ENV_GAMENAME_1=
ENV_GAMENAME_2=
ENV_GAMENAME_3=

#Serverdaten – XDE (html/inc/serverdata.inc.php); leer = Default
#Defaults: tag=xDE, name=Pinwheel, container=0, containerbg=0, containercolor=#3399FF,
#wt=10, kt=60, description=beschreibungxde, host=xde.die-ewigen.com, url=/,
#paytype=1, gametyp=1, language=1, cooperation=0,1,2, conditions=9999999,
#newplayers=0, databasekey=xde
ENV_SERVER_XDE_TAG=
ENV_SERVER_XDE_NAME=
ENV_SERVER_XDE_CONTAINER=
ENV_SERVER_XDE_CONTAINERBG=
ENV_SERVER_XDE_CONTAINERCOLOR=
ENV_SERVER_XDE_WT=
ENV_SERVER_XDE_KT=
ENV_SERVER_XDE_DESCRIPTION=
ENV_SERVER_XDE_HOST=
ENV_SERVER_XDE_URL=
ENV_SERVER_XDE_PAYTYPE=
ENV_SERVER_XDE_GAMETYPE=
ENV_SERVER_XDE_LANGUAGE=
ENV_SERVER_XDE_COOPERATION=
ENV_SERVER_XDE_CONDITIONS=
ENV_SERVER_XDE_NEWPLAYERS=
ENV_SERVER_XDE_DATABASEKEY=

#Serverdaten – SDE (html/inc/serverdata.inc.php); leer = Default
#Defaults: tag=SDE, name=Andromeda, container=0, containerbg=0, containercolor=#3399FF,
#wt=3, kt=12, description=beschreibungsde, host=sde.die-ewigen.com, url=/,
#paytype=1, gametyp=1, language=1, cooperation=0,1,2, conditions=9999999,
#newplayers=1, databasekey=sde
ENV_SERVER_SDE_TAG=
ENV_SERVER_SDE_NAME=
ENV_SERVER_SDE_CONTAINER=
ENV_SERVER_SDE_CONTAINERBG=
ENV_SERVER_SDE_CONTAINERCOLOR=
ENV_SERVER_SDE_WT=
ENV_SERVER_SDE_KT=
ENV_SERVER_SDE_DESCRIPTION=
ENV_SERVER_SDE_HOST=
ENV_SERVER_SDE_URL=
ENV_SERVER_SDE_PAYTYPE=
ENV_SERVER_SDE_GAMETYPE=
ENV_SERVER_SDE_LANGUAGE=
ENV_SERVER_SDE_COOPERATION=
ENV_SERVER_SDE_CONDITIONS=
ENV_SERVER_SDE_NEWPLAYERS=
ENV_SERVER_SDE_DATABASEKEY=
